{
  "schema_version": 1,
  "kind": "context-index",
  "project": "{{PROJECT_NAME}}",
  "summary": "{{ONE_SENTENCE_PROJECT_SUMMARY}}",
  "modules": [
    {
      "path": ".",
      "summary": "{{ROOT_MODULE_SUMMARY}}",
      "context": ".hek/context/AI.md",
      "read_when": ["{{ROUTING_KEYWORD}}"]
    }
  ],
  "entrypoints": {
    "policy": ".hek/project/agent-policy.yaml",
    "lifecycle": ".hek/kit/core/change-lifecycle.md"
  }
}
