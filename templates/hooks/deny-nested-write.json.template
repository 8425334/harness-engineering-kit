{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hek workspace guard --path \"$HEK_TOOL_PATH\" --session-root \"$HEK_SESSION_ROOT\" --json"
          }
        ]
      }
    ]
  }
}
