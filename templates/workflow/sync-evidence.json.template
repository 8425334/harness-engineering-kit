{
  "schema_version": 3,
  "actor": "{{ACTOR}}",
  "at": "{{YYYY-MM-DDTHH:MM:SSZ}}",
  "targets": [
    {
      "source": "specs/{{CAPABILITY}}/spec.md",
      "destination": "openspec/specs/{{CAPABILITY}}/spec.md",
      "source_sha256": "{{APPROVED_CHANGE_SPEC_SHA256}}",
      "destination_sha256": "{{SYNCED_CANONICAL_SPEC_SHA256}}",
      "before_snapshot": "evidence/pre-sync/{{CAPABILITY}}/spec.md",
      "before_sha256": "{{PRE_SYNC_CANONICAL_SPEC_SHA256}}"
    }
  ],
  "checks": [
    {
      "id": "openspec_validate_specs",
      "command": "openspec validate --specs",
      "status": "passed",
      "exit_code": 0,
      "evidence": "openspec/changes/{{CHANGE_ID}}/evidence/openspec-validate-specs.log",
      "evidence_sha256": "{{OPENSPEC_VALIDATE_LOG_SHA256}}"
    },
    {
      "id": "sync_semantics",
      "command": "python3 docs/fitness/scripts/fitness.py --stage=sync --change {{CHANGE_ID}} --tier fast --report openspec/changes/{{CHANGE_ID}}/evidence/fitness-sync.json",
      "status": "passed",
      "exit_code": 0,
      "evidence": "openspec/changes/{{CHANGE_ID}}/evidence/fitness-sync.json",
      "evidence_sha256": "{{FITNESS_REPORT_SHA256}}"
    }
  ]
}
