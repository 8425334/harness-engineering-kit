#!/usr/bin/env python3
"""Reject executable SQL embedded in production Mapper Java files.

XML is the owning location for custom Mapper SQL. Type-safe lambda/MPJ
expressions remain valid, including string table aliases such as ``"u"``.

Copy to: docs/fitness/scripts/check_mapper_inline_sql.py
"""
# {{CHECK_MAPPER_INLINE_SQL_TEMPLATE}}

from __future__ import annotations

import re
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[3]

# Configure: root directories that contain production Mapper Java sources.
# `*Mapper.java` files are discovered recursively under each root; only paths
# that live under a `src/main/java` segment are scanned, so test and generated
# sources are ignored. Each root may point at a module root (e.g.
# ``PROJECT_ROOT / "modules" / "foo"``) or directly at the source directory
# (e.g. ``PROJECT_ROOT / "src" / "main" / "java"``). Generic examples:
#   MAPPER_SOURCE_ROOTS = (
#       PROJECT_ROOT / "modules" / "foo",
#       PROJECT_ROOT / "modules" / "bar",
#   )
MAPPER_SOURCE_ROOTS = (  # {{MAPPER_SOURCE_ROOTS}}
    PROJECT_ROOT / "src" / "main" / "java",
)

FORBIDDEN_ANNOTATIONS = re.compile(
    r"@(Select|Insert|Update|Delete|SelectKey|SelectProvider|InsertProvider|UpdateProvider|DeleteProvider)\s*\(",
)
FORBIDDEN_METHODS = re.compile(r"\.(apply|last|having|setSql|\w+Sql)\s*\(")
PROJECTION_CALL = re.compile(r"\.(selectAs|select)\s*\(")
SQL_PROJECTION = re.compile(
    r"\b(COUNT|SUM|AVG|MIN|MAX|COALESCE|NULLIF|TRIM|CASE|WHEN|SELECT|FROM|JOIN|GROUP|ORDER|ASC|DESC|IFNULL|CONCAT)\b"
    r"|[()+*/=]",
    re.IGNORECASE,
)
# Configure: path parts that mark a directory as non-production. Matched
# against every path segment, so `test`/`tests` also exclude test sources.
EXCLUDED_PARTS = {
    ".git",
    "target",
    "test",
    "tests",
    "__pycache__",
    "generated-sources",
}


def _without_comments(source: str) -> str:
    """Remove Java comments while preserving character offsets and line breaks."""
    comment = re.compile(r"//[^\n]*|/\*.*?\*/", re.DOTALL)

    def replace(match: re.Match[str]) -> str:
        return "".join("\n" if char == "\n" else " " for char in match.group())

    return comment.sub(replace, source)


def _line_number(source: str, offset: int) -> int:
    return source.count("\n", 0, offset) + 1


def _display_path(path: Path) -> str:
    try:
        return str(path.relative_to(PROJECT_ROOT))
    except ValueError:
        return str(path)


def _call_end(source: str, opening: int) -> int | None:
    """Find a call's closing parenthesis, respecting Java string literals."""
    depth = 0
    quote: str | None = None
    escaped = False
    for index in range(opening, len(source)):
        char = source[index]
        if quote:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == quote:
                quote = None
            continue
        if char in {"\"", "'"}:
            quote = char
        elif char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
            if depth == 0:
                return index
    return None


def _top_level_arguments(arguments: str) -> list[str]:
    result: list[str] = []
    start = 0
    depth = 0
    quote: str | None = None
    escaped = False
    for index, char in enumerate(arguments):
        if quote:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == quote:
                quote = None
        elif char in {"\"", "'"}:
            quote = char
        elif char in "([{":
            depth += 1
        elif char in ")]}":
            depth -= 1
        elif char == "," and depth == 0:
            result.append(arguments[start:index].strip())
            start = index + 1
    result.append(arguments[start:].strip())
    return result


def _raw_projection(method: str, arguments: str) -> bool:
    """Detect SQL expressions while allowing MPJ alias + method-reference forms."""
    if '"' not in arguments:
        return False
    parts = _top_level_arguments(arguments)
    first = parts[0] if parts else ""
    if method == "selectAs":
        return bool(SQL_PROJECTION.search(first))
    return len(parts) > 1 and bool(SQL_PROJECTION.search(arguments))


def scan_mapper_file(filepath: Path) -> list[dict[str, object]]:
    """Return violations with file, line, pattern, and source fields."""
    try:
        original = filepath.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return []

    source = _without_comments(original)
    violations: list[dict[str, object]] = []

    def add(offset: int, pattern: str) -> None:
        line = original.splitlines()[_line_number(original, offset) - 1].strip()
        violations.append({
            "file": _display_path(filepath),
            "line": _line_number(original, offset),
            "offset": offset,
            "pattern": pattern,
            "content": line,
        })

    for match in FORBIDDEN_ANNOTATIONS.finditer(source):
        add(match.start(), "sql-annotation")

    for match in FORBIDDEN_METHODS.finditer(source):
        method = match.group(1)
        add(match.start(), "raw-" + method)

    for match in PROJECTION_CALL.finditer(source):
        end = _call_end(source, source.find("(", match.start()))
        if end is not None and _raw_projection(match.group(1), source[source.find("(", match.start()) + 1:end]):
            add(match.start(), "raw-" + match.group(1))

    return sorted(violations, key=lambda violation: int(violation["offset"]))


def iter_production_mappers() -> list[Path]:
    """Find production Mapper Java sources under the configured roots."""
    files = []
    for root in MAPPER_SOURCE_ROOTS:
        if not root.exists():
            continue
        for path in root.rglob("*Mapper.java"):
            parts = set(path.parts)
            if "src" not in parts or "main" not in parts or "java" not in parts:
                continue
            if parts & EXCLUDED_PARTS or "Impl" in path.stem or "POTo" in path.stem:
                continue
            files.append(path)
    return sorted(files)


def main() -> int:
    violations = [v for path in iter_production_mappers() for v in scan_mapper_file(path)]
    if violations:
        print(f"Mapper inline SQL violations found: {len(violations)}")
        for violation in violations:
            print(
                f"  {violation['file']}:{violation['line']} "
                f"[{violation['pattern']}] {violation['content']}"
            )
        return 1
    print("Mapper inline SQL ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
