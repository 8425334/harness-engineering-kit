export const meta = {
  name: 'ramer-implement',
  description: 'RAMER Implementation: EXECUTE (DDD-aware file creation) -> REVIEW (fitness gate + DDD dependency check)',
  phases: [
    { title: 'EXECUTE', detail: 'Implement files against design contract — domain, ports, adapters, application, controllers' },
    { title: 'REVIEW', detail: 'Fitness gate, DDD dependency inversion check, three-way consistency, permissions audit' },
  ],
}

const REVIEW_SCHEMA = {
  type: 'object',
  properties: {
    fitnessGatePassed: { type: 'boolean' },
    fitnessOutput: { type: 'string' },
    issues: {
      type: 'array', items: {
        type: 'object', properties: {
          severity: { type: 'string', enum: ['error', 'warning'] },
          file: { type: 'string' },
          check: { type: 'string' },
          detail: { type: 'string' },
          fix: { type: 'string' },
        }, required: ['severity', 'file', 'check', 'detail']
      }
    },
    consistencyChecks: {
      type: 'object', properties: {
        mapperXmlEntity: { type: 'boolean' },
        permissionsComplete: { type: 'boolean' },
        javadocComplete: { type: 'boolean' },
        noDebugPrints: { type: 'boolean' },
        sqlLocationCorrect: { type: 'boolean' },
        boundaryClean: { type: 'boolean' },
        dependencyInversion: { type: 'boolean', description: 'Domain has no Spring imports; app injects ports not adapters' },
        adapterAclPresent: { type: 'boolean', description: 'Every adapter has ACL mapping comment' },
        portRationalePresent: { type: 'boolean', description: 'Every port has rationale Javadoc' },
        domainPurity: { type: 'boolean', description: 'domain/model/ and domain/service/ have zero framework imports' },
      }
    },
    summary: { type: 'string' },
  },
  required: ['fitnessGatePassed', 'issues', 'summary'],
}

const designContract = args?.designContract || args
const plan = designContract?.implementationPlan || []
const arch = designContract?.architecture?.style || 'crud'

if (!plan.length) {
  throw new Error('No implementation plan found in design contract.')
}

// ================================================================
// EXECUTE Prompt — DDD-aware file creation
// ================================================================
const EXECUTE_PROMPT = function(step, designContract) {
  var arch = designContract?.architecture?.style || 'crud'
  var layer = step.layer || 'interface'
  var fileType = step.type || 'unknown'
  var extraRules = ''

  if (layer === 'domain') {
    extraRules = [
      '',
      '**DOMAIN LAYER RULES (CRITICAL):**',
      '- ZERO Spring imports (@Service, @Component, @Autowired are FORBIDDEN)',
      '- ZERO MyBatis-Plus imports (@TableName, @TableId, BaseMapper are FORBIDDEN)',
      '- ZERO Redis imports (RedisTemplate, RedisUtils are FORBIDDEN)',
      '- If aggregate root: enforce invariants in every state-changing method',
      '- If value object: ALL fields final, no setters, validate in constructor, equals/hashCode by value',
      '- If domain service: pure Java class — instantiate with new, not injected',
      '- If domain event: extend ApplicationEvent, payload uses domain types only'
    ].join('\n')
  } else if (layer === 'application') {
    extraRules = [
      '',
      '**APPLICATION LAYER RULES:**',
      '- @Service, @RequiredArgsConstructor',
      '- Inject PORT interfaces (NEVER adapter classes)',
      '- One public method per use case',
      '- Call domain service for decisions, ports for I/O',
      '- Publish domain events via ApplicationEventPublisher',
      '- NEVER import adapter classes directly'
    ].join('\n')
  } else if (layer === 'infrastructure') {
    extraRules = [
      '',
      '**INFRASTRUCTURE LAYER RULES (ADAPTER):**',
      '- @Component, @RequiredArgsConstructor',
      '- Implements ONE port interface',
      '- Anti-Corruption Layer: map infrastructure types -> domain types',
      '- Add Javadoc comment explaining the ACL mapping',
      '- NEVER leak infrastructure types through the port interface',
      '- Inject Spring beans as needed'
    ].join('\n')
  } else if (fileType === 'entity' || fileType === 'vo' || fileType === 'bo' || fileType === 'mapper' || fileType === 'xml') {
    extraRules = [
      '',
      '**ENTITY QUARTET RULES:**',
      '- Entity: extend {{ORM_ENTITY_BASE}}, @TableName, {{ORM_ID_STRATEGY}}, {{ORM_LOGIC_DELETE}}',
      '- VO: {{ORM_AUTO_MAPPER}}, fields mirror Entity',
      '- BO: input fields with validation (@NotBlank, @NotNull)',
      '- Mapper: {{ORM_MAPPER_BASE}}',
      '- XML: namespace matches Mapper fully-qualified name'
    ].join('\n')
  }

  return [
    'You are the **EXECUTE** phase. Implement ONE file according to the design contract.',
    '',
    'ARCHITECTURE STYLE: ' + arch.toUpperCase(),
    'LAYER: ' + layer.toUpperCase(),
    '',
    'YOUR TASK: Step ' + (step.step || '?') + ': ' + (step.action || 'create') + ' -> ' + (step.file || 'unknown'),
    'Module: ' + (step.module || 'unknown'),
    'Description: ' + (step.description || 'N/A'),
    'Key Instructions: ' + (step.keyInstructions || 'Follow existing patterns'),
    '',
    'FULL DESIGN CONTRACT:',
    JSON.stringify(designContract, null, 2),
    extraRules,
    '',
    'GENERAL RULES:',
    '1. Read a nearby file in the same package and MATCH ITS STYLE: imports order, annotation placement, Javadoc density, indentation',
    '2. Every public method must have Javadoc',
    '3. No System.out, console.log, printStackTrace, debugger statements',
    '4. For MODIFIED files: read existing file first, make minimal surgical changes, do not reformat unrelated code',
    '5. Keep implementation minimal — program to interface, composition over inheritance (depth <= 1)',
    '',
    'Write the complete file. Output a brief summary of what you created/modified.'
  ].join('\n')
}

// ================================================================
// REVIEW Prompt — Fitness gate + DDD dependency check
// ================================================================
const REVIEW_PROMPT = function(designContract) {
  var arch = designContract?.architecture?.style || 'crud'
  var dddChecks = (arch === 'ddd' || arch === 'hexagonal' || arch === 'hybrid') ? [
    '',
    '**DDD-SPECIFIC CHECKS:**',
    '1. **Dependency Inversion**: Grep domain/model/ and domain/service/ for forbidden imports:',
    '   - org.springframework (any match = VIOLATION)',
    '   - com.baomidou.mybatisplus (any match = VIOLATION)',
    '   - org.springframework.data.redis (any match = VIOLATION)',
    '2. **Port injection audit**: For each application service, verify @RequiredArgsConstructor fields are port interfaces, not adapter classes',
    '3. **Adapter ACL**: For each adapter, verify Javadoc mentions the ACL mapping',
    '4. **Port rationale**: For each port interface, verify Javadoc explains what infrastructure concern is being abstracted'
  ].join('\n') : ''

  return [
    'You are the **REVIEW** phase. Verify the implementation against fitness gate and DDD rules.',
    '',
    'ARCHITECTURE STYLE: ' + arch.toUpperCase(),
    '',
    'DESIGN CONTRACT:',
    JSON.stringify(designContract, null, 2),
    '',
    'STEPS:',
    '',
    '1. **Run fitness gate**: {{FITNESS_COMMAND}}',
    '   Capture ALL output. Parse pass/fail for each check.',
    '',
    '2. **Three-way consistency** (if entities exist):',
    '   - Mapper interface type params match Entity',
    '   - XML namespace matches Mapper, column mappings match Entity fields',
    '   - VO @AutoMapper target matches Entity',
    '',
    '3. **Permission audit**:',
    '   - Read every controller in the design',
    '   - Confirm every @GetMapping/@PostMapping/@PutMapping/@DeleteMapping has {{AUTH_FRAMEWORK}} annotation',
    '',
    '4. **Javadoc audit**: All public methods in new/modified files have Javadoc',
    '',
    '5. **Cleanliness**:',
    '   - Grep changed files for: System.out, console.log, printStackTrace, debugger',
    '   - Grep for {{BASE_PACKAGE}} in {{INFRA_MODULE}} (should be NONE)',
    '6. **SQL migration**: confirm file exists at specified path' + dddChecks,
    '',
    'Output structured review data. For every issue, provide a CONCRETE fix.',
    'fitnessGatePassed = true ONLY if fitness gate passes AND all checks are clean.'
  ].join('\n')
}

// ================================================================
// Orchestration
// ================================================================
phase('EXECUTE')
log('Implementing ' + plan.length + ' files in ' + arch.toUpperCase() + ' style: ' + (designContract?.summary || ''))

var sortedPlan = plan.slice().sort(function(a, b) {
  var aDeps = a.dependsOn || []
  var bDeps = b.dependsOn || []
  if (aDeps.length === 0 && bDeps.length > 0) return -1
  if (bDeps.length === 0 && aDeps.length > 0) return 1
  var layerOrder = { domain: 0, infrastructure: 1, application: 2, interface: 3 }
  return (layerOrder[a.layer] || 99) - (layerOrder[b.layer] || 99)
})

log('Execution order: ' + sortedPlan.map(function(s) { return '#' + s.step + '(' + (s.layer || '?') + ')' }).join(' -> '))

var results = await parallel(
  sortedPlan.map(function(step) {
    return function() {
      return agent(EXECUTE_PROMPT(step, designContract), {
        label: (step.layer || 'EXEC') + ': ' + (step.file || '').split('/').pop(),
        phase: 'EXECUTE',
      })
    }
  })
)

var succeeded = results.filter(Boolean).length
var failed = results.length - succeeded
log('EXECUTE — ' + succeeded + '/' + results.length + ' files done' + (failed > 0 ? ', ' + failed + ' FAILED' : ''))

phase('REVIEW')
log('Running fitness gate + DDD dependency checks...')
var reviewOutput = await agent(REVIEW_PROMPT(designContract), {
  label: 'REVIEW: fitness gate + DDD checks',
  schema: REVIEW_SCHEMA,
})
if (!reviewOutput) throw new Error('REVIEW phase failed.')

if (reviewOutput.fitnessGatePassed) {
  log('REVIEW PASSED — fitness gate green, all DDD checks clean')
} else {
  var count = reviewOutput.issues ? reviewOutput.issues.length : 0
  log('REVIEW — ' + count + ' issues found')
  if (reviewOutput.issues) {
    reviewOutput.issues.forEach(function(i) {
      log('  [' + i.severity + '] ' + i.file + ': ' + i.check + ' — ' + i.detail)
    })
  }
}

return {
  implementation: { totalFiles: results.length, succeeded: succeeded, failed: failed },
  review: reviewOutput,
}
