// ================================================================
// READ Prompt
// ================================================================
const requirement = typeof args === 'string' ? args : (args?.requirement || JSON.stringify(args))

const READ_PROMPT = [
  'You are the **READ** phase of the RAMER cycle. Gather and summarize ALL relevant context.',
  '',
  'REQUIREMENT: ' + requirement,
  '',
  'Steps:',
  '1. Determine target path and run: {{AI_CONTEXT_SCRIPT}} <target-path>',
  '2. Read all returned ai.json/AI.md files.',
  '3. Read key source files in the target area.',
  '4. **Detect architecture style**:',
  '   - **layered**: controller -> service/impl -> mapper (traditional)',
  '   - **hexagonal-ddd**: domain/model + domain/service + port/ + adapter/ + application/',
  '   - **hybrid**: mix of both',
  '5. For DDD areas: identify aggregates, value objects, ports, adapters, domain services, domain events.',
  '6. For traditional areas: identify Entity Quartet classes, support classes, event listeners.',
  '',
  '{{DDD_REFERENCE_CONTEXT}}',
  '',
  'Output structured data. ANALYZE and MODEL depend on your output.'
].join('\n')

// ================================================================
// ANALYZE Prompt — with Architecture Decision Tree
// ================================================================
const ANALYZE_PROMPT = function(readOutput) {
  return [
    'You are the **ANALYZE** phase. Classify the architecture and identify exactly what needs to change.',
    '',
    'REQUIREMENT: ' + requirement,
    '',
    'READ OUTPUT:',
    JSON.stringify(readOutput, null, 2),
    '',
    '## Architecture Decision Tree',
    '',
    '| Signal | Style |',
    '|--------|-------|',
    '| Simple CRUD, no invariants, no cross-system orchestration | **crud** (Entity Quartet + service/impl) |',
    '| Complex business rules, state machines, invariants, pure domain logic | **ddd** (aggregate + domain service + ports + adapters) |',
    '| Multiple external systems, heavy orchestration, existing port/adapter pattern in target | **hexagonal** (ports + adapters + application service) |',
    '| Mix: some CRUD, some complex logic | **hybrid** (combine both patterns) |',
    '',
    '**CRITICAL**: If target already uses hexagonal-ddd (port/, adapter/, domain/model/), MUST continue that pattern.',
    'If target uses traditional layered, only upgrade to DDD when business complexity warrants it.',
    '',
    '## DDD Layer Conventions',
    '',
    '| Artifact | Package | Spring? |',
    '|----------|---------|---------|',
    '| Aggregate Root | <ctx>/domain/model/ | NO (pure Java) |',
    '| Value Object (record) | <ctx>/domain/model/ | NO (immutable) |',
    '| Domain Service | <ctx>/domain/service/ | NO (instantiated with new) |',
    '| Domain Event | <ctx>/domain/event/ | extends ApplicationEvent |',
    '| Port (interface) | <ctx>/port/ | NO (interface only) |',
    '| Adapter | <ctx>/adapter/ | @Component, @RequiredArgsConstructor |',
    '| Application Service | <ctx>/application/ | @Service, @RequiredArgsConstructor |',
    '',
    '## Dependency Rule (non-negotiable for DDD)',
    'domain -> depends on NOTHING (no Spring, MyBatis, Redis imports)',
    'port -> depends on domain (uses domain types in signatures)',
    'adapter -> depends on port + infrastructure (Spring, Redis, etc.)',
    'application -> depends on domain + ports (injects port interfaces, NEVER adapters)',
    '',
    '## Steps',
    '1. Restate requirement in precise technical terms',
    '2. Run decision tree with specific signals from the requirement',
    '3. Define bounded context + ubiquitous language (if DDD)',
    '4. List EVERY file to create/modify with DDD layer annotation',
    '5. Order: domain models -> ports -> adapters -> application -> controllers',
    '6. Identify cross-cutting: permissions, SQL migrations, events',
    '',
    'Output structured data. Every file must be listed.'
  ].join('\n')
}

// ================================================================
// MODEL Prompt — DDD-aware design contract
// ================================================================
const MODEL_PROMPT = function(readOutput, analyzeOutput) {
  var arch = (analyzeOutput && analyzeOutput.architectureDecision) ? analyzeOutput.architectureDecision.style : 'crud'
  return [
    'You are the **MODEL** phase — the most critical phase. Produce a COMPLETE, IMPLEMENTATION-READY design contract.',
    '',
    'REQUIREMENT: ' + requirement,
    'ARCHITECTURE STYLE: ' + arch,
    '',
    'ARCHITECTURE CONTEXT:',
    JSON.stringify(readOutput, null, 2),
    '',
    'IMPACT ANALYSIS:',
    JSON.stringify(analyzeOutput, null, 2),
    '',
    '## Design Principles',
    '',
    '### For DDD / Hexagonal:',
    '',
    '**Aggregate Design**:',
    '- One aggregate root per cluster; enforces ALL invariants',
    '- External references by ID, not object reference',
    '- Repository port ONLY for aggregate root (not internal entities)',
    '',
    '**Value Object Design**:',
    '- Immutable — all fields final, set in constructor',
    '- Self-validating in constructor',
    '- Equality by value (implement equals/hashCode)',
    '- Replace instead of mutate (no setters)',
    '',
    '**Port Design**:',
    '- One port = one infrastructure concern (repository, gateway, cache, auth, messaging)',
    '- Methods use DOMAIN types only — NEVER infrastructure DTOs or framework types',
    '- Each port must have a rationale: what infrastructure detail is being abstracted?',
    '',
    '**Adapter Design with ACL**:',
    '- Implements ONE port',
    '- Anti-Corruption Layer: maps infrastructure types -> domain types',
    '- @Component; injects Spring beans (@RequiredArgsConstructor)',
    '- NEVER leak infrastructure types through the port interface',
    '',
    '**Domain Service Design**:',
    '- Pure Java — ZERO Spring/MyBatis/Redis imports',
    '- Instantiated with new (not injected)',
    '- Returns discriminated types (records/sealed interfaces) for decisions',
    '- Testable without Spring context',
    '',
    '**Application Service Design**:',
    '- One public method per use case',
    '- @Service, @RequiredArgsConstructor',
    '- Injects PORTS (interfaces), NEVER adapters directly',
    '- Domain service for decisions + ports for I/O + eventPublisher for events',
    '',
    '**Domain Event Design**:',
    '- extends Spring ApplicationEvent for compatibility',
    '- Payload: domain types only, not raw primitives',
    '- Published by application service; consumed by @EventListener',
    '',
    '### For CRUD (when applicable):',
    '- Entity Quartet: Entity + VO + BO + Mapper + XML',
    '- Entity extends {{ORM_ENTITY_BASE}}; @TableName, {{ORM_ID_STRATEGY}}, {{ORM_LOGIC_DELETE}}',
    '- VO: {{ORM_AUTO_MAPPER}}; Mapper: {{ORM_MAPPER_BASE}}',
    '',
    '## Self-Check',
    '- [ ] Domain layer ZERO Spring/MyBatis/Redis imports (DDD)',
    '- [ ] Application services inject port interfaces, NOT adapter classes (DDD)',
    '- [ ] Every aggregate has at least one invariant (DDD)',
    '- [ ] Every port has rationale (DDD)',
    '- [ ] Every adapter declares ACL mapping (DDD)',
    '- [ ] Implementation plan: domain -> ports -> adapters -> application -> controllers',
    '- [ ] Every controller endpoint has {{AUTH_FRAMEWORK}} permission',
    '- [ ] SQL migration in {{SQL_MIGRATION_PATH}}YYYYMMDD_xxx.sql',
    '',
    'Output structured data. This IS the specification EXECUTE will implement.'
  ].join('\n')
}

// ================================================================
// Orchestration
// ================================================================
phase('READ')
log('Loading path documents and detecting architecture style...')
var readOutput = await agent(READ_PROMPT, {
  label: 'READ: context + architecture detection',
  schema: READ_SCHEMA,
})
if (!readOutput) throw new Error('READ phase failed.')
log('READ — ' + (readOutput.architectureStyle || '?') + ', ' + (readOutput.aiDocsLoaded ? readOutput.aiDocsLoaded.length : 0) + ' docs, ' + (readOutput.keyClasses ? readOutput.keyClasses.length : 0) + ' classes')

phase('ANALYZE')
log('Classifying architecture (CRUD/DDD/Hexagonal/Hybrid)...')
var analyzeOutput = await agent(ANALYZE_PROMPT(readOutput), {
  label: 'ANALYZE: architecture decision',
  schema: ANALYZE_SCHEMA,
})
if (!analyzeOutput) throw new Error('ANALYZE phase failed.')
var arch = (analyzeOutput.architectureDecision && analyzeOutput.architectureDecision.style) ? analyzeOutput.architectureDecision.style : 'crud'
log('ANALYZE — ' + arch.toUpperCase() + ', ' + (analyzeOutput.newFiles ? analyzeOutput.newFiles.length : 0) + ' new, ' + (analyzeOutput.affectedModules ? analyzeOutput.affectedModules.length : 0) + ' modules')

phase('MODEL')
log('Designing ' + arch.toUpperCase() + ' contract...')
var designContract = await agent(MODEL_PROMPT(readOutput, analyzeOutput), {
  label: 'MODEL: DDD-aware design contract',
  schema: MODEL_SCHEMA,
})
if (!designContract) throw new Error('MODEL phase failed.')
var stats = [
  (designContract.aggregates ? designContract.aggregates.length : 0) + ' aggregates',
  (designContract.valueObjects ? designContract.valueObjects.length : 0) + ' VOs',
  (designContract.domainServices ? designContract.domainServices.length : 0) + ' domainSvcs',
  (designContract.ports ? designContract.ports.length : 0) + ' ports',
  (designContract.adapters ? designContract.adapters.length : 0) + ' adapters',
  (designContract.applicationServices ? designContract.applicationServices.length : 0) + ' appSvcs',
  (designContract.domainEvents ? designContract.domainEvents.length : 0) + ' events',
  (designContract.entities ? designContract.entities.length : 0) + ' entities',
  (designContract.implementationPlan ? designContract.implementationPlan.length : 0) + ' steps'
]
log('MODEL — ' + stats.join(', '))

return {
  designContract: designContract,
  context: { read: readOutput, analyze: analyzeOutput },
}
