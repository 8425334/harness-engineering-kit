#!/usr/bin/env python3
"""Check changed AI.md files and required Harness AI docs are synchronized.

Depends on a converter script that converts AI.md → ai.json. The converter is
project-specific because it knows the AI.md heading conventions used in the
project. See {{AI_MD_CONVERTER}} below.

Copy to: docs/fitness/scripts/check_ai_json_sync.py
"""
# {{CHECK_AI_JSON_SYNC_TEMPLATE}}

from __future__ import annotations

import importlib.util
import json
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[3]
# Configure: path to the AI.md → ai.json converter, relative to project root.
# This script is project-specific (depends on AI.md heading conventions).
# Reference implementation: scripts/ai_md_to_json.py
CONVERTER_PATH = PROJECT_ROOT / "{{AI_MD_CONVERTER}}"
EXCLUDED_PARTS = {".git", "node_modules", "dist", "target"}


def load_converter():
    spec = importlib.util.spec_from_file_location("ai_md_to_json", CONVERTER_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load converter: {CONVERTER_PATH}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def should_skip(path: Path) -> bool:
    return any(part in EXCLUDED_PARTS for part in path.parts)


def git_lines(args: list[str]) -> list[str]:
    result = __import__("subprocess").run(
        ["git", *args],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def target_ai_files() -> list[Path]:
    changed = set(git_lines(["diff", "--name-only", "--diff-filter=AM", "--", "*AI.md"]))
    changed.update(git_lines(["diff", "--cached", "--name-only", "--diff-filter=AM", "--", "*AI.md"]))
    # Configure: AI.md files that must always be in sync (entry points).
    # Adjust or remove these to match your project's Harness entry points.
    changed.add(".github/AI.md")
    changed.add("docs/fitness/AI.md")
    return sorted(
        PROJECT_ROOT / path
        for path in changed
        if path.endswith("AI.md") and (PROJECT_ROOT / path).exists()
    )


def main() -> int:
    converter = load_converter()
    missing: list[str] = []
    drifted: list[str] = []
    errors: list[str] = []

    for ai_md in target_ai_files():
        rel = ai_md.relative_to(PROJECT_ROOT)
        if should_skip(rel):
            continue

        ai_json = ai_md.parent / "ai.json"
        if not ai_json.exists():
            missing.append(str(rel.parent / "ai.json"))
            continue

        try:
            expected = converter.clean_json_output(converter.convert_file(str(ai_md)))
            actual = json.loads(ai_json.read_text(encoding="utf-8"))
        except Exception as exc:
            errors.append(f"{rel}: {exc}")
            continue

        if actual != expected:
            drifted.append(str(rel))

    if missing or drifted or errors:
        if missing:
            print("Missing ai.json files:")
            for item in missing[:20]:
                print(f"  {item}")
        if drifted:
            print("Drifted AI docs:")
            for item in drifted[:20]:
                print(f"  {item}")
        if errors:
            print("AI doc check errors:")
            for item in errors[:20]:
                print(f"  {item}")
        return 1

    print("AI JSON sync ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
