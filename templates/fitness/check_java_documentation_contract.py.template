#!/usr/bin/env python3
"""Check changed Java models and core logic carry human-readable explanations.

Ensures data models (fields), and core logic (classes/methods/state flow)
that touch changed lines carry a Javadoc comment or a description annotation.

Java-only. Skip or replace if your project uses a different language.

Copy to: docs/fitness/scripts/check_java_documentation_contract.py
"""
# {{CHECK_JAVA_DOCUMENTATION_CONTRACT_TEMPLATE}}

from __future__ import annotations

import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[3]
IGNORED_CHANGED_NAMES = {".DS_Store"}
IGNORED_CHANGED_PARTS = {
    "__pycache__",
    "target",
    "generated",
    # {{EXTRA_IGNORED_CHANGED_PARTS}} — add project build/dependency dirs, e.g.:
    # ".mvn",
    # "node_modules",
}
# Configure: path segments that mark a production Java source root.
PRODUCTION_SOURCE_PARTS = ("src", "main", "java")  # {{PRODUCTION_SOURCE_PARTS}}
# Configure: file suffixes treated as data models (DTO/VO/BO/query objects)
# whose fields must carry an explanation.
MODEL_SUFFIXES = (  # {{MODEL_SUFFIXES}}
    "Bo.java",
    "Dto.java",
    "DTO.java",
    "Form.java",
    "Param.java",
    "Payload.java",
    "Query.java",
    "QueryBo.java",
    "Request.java",
    "Response.java",
    "Vo.java",
    "VO.java",
)
# Configure: file suffixes treated as core logic (entry points, services,
# adapters, jobs) that must carry human-readable explanations.
CORE_SUFFIXES = (  # {{CORE_SUFFIXES}}
    "Adapter.java",
    "Client.java",
    "Controller.java",
    "Handler.java",
    "Listener.java",
    "Manager.java",
    "Processor.java",
    "ServiceImpl.java",
    "Support.java",
    "Task.java",
    "Job.java",
)
# Configure: path segments that mark a file as core logic regardless of
# suffix (layered-architecture directories such as controller/service/job).
CORE_PATH_PARTS = {  # {{CORE_PATH_PARTS}}
    "controller",
    "service",
    "support",
    "application",
    "infrastructure",
    "interfaces",
    "job",
}
# Configure: annotations whose description/name/value/title counts as an
# explanation for a field (Swagger, OpenAPI, Excel export, etc.).
EXPLANATION_ANNOTATIONS = (  # {{EXPLANATION_ANNOTATIONS}}
    "@ApiModelProperty",
    "@Excel",
    "@ExcelProperty",
    "@Schema",
)
ACCESS_MODIFIERS = ("public", "protected", "private")
# Configure: minimum meaningful content for a comment to count as an
# explanation. CJK characters are counted individually; other characters are
# counted after stripping punctuation. Adjust for your documentation language.
MIN_CJK_CHARS = {{MIN_CJK_CHARS}}  # e.g. 2
MIN_MEANINGFUL_CHARS = {{MIN_MEANINGFUL_CHARS}}  # e.g. 4

METHOD_DECLARATION_RE = re.compile(
    r"\b(public|protected|private)\b[\w\s<>\[\],.?]*\s+(\w+)\s*\([^;{}]*\)"
)
CLASS_DECLARATION_RE = re.compile(r"\b(class|interface|enum)\s+(\w+)")
BRANCH_FLOW_RE = re.compile(r"\b(if|else|switch|case|for|while|try|catch)\b|&&|\|\|")
# Configure: status/state keywords that signal state-machine flow inside a
# method body. These are usually project-specific enum values and field names;
# extend with your own state keywords. Entries may be regex fragments.
STATUS_FLOW_KEYWORDS = (  # {{STATUS_FLOW_KEYWORDS}}
    r"\w*Status",
    "status",
    "state",
    "lifecycleStatus",
    r"\w*Status\w*",
    "PENDING",
    "DISPATCHED",
    "EXECUTING",
    "COMPLETED",
    "FAILED",
    "TIMEOUT",
    "VERIFIED",
    "LIMITED",
    "UNSUPPORTED",
)
STATUS_FLOW_RE = re.compile(
    r"\b(" + "|".join(STATUS_FLOW_KEYWORDS) + r")\b",
    re.IGNORECASE,
)


@dataclass(frozen=True)
class MethodInfo:
    name: str
    access: str
    declaration_index: int
    body_start_index: int
    body_end_index: int
    declaration_lines: list[str]
    body_lines: list[str]


def git_lines(args: list[str]) -> list[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def git_text(args: list[str]) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return ""
    return result.stdout


def changed_paths() -> set[str]:
    changed = set(git_lines(["diff", "--name-only", "--diff-filter=ACMR"]))
    changed.update(git_lines(["diff", "--cached", "--name-only", "--diff-filter=ACMR"]))
    changed.update(git_lines(["ls-files", "--others", "--exclude-standard"]))
    return {path for path in changed if not is_ignored_changed_path(path)}


def parse_changed_lines(diff_text: str) -> set[int]:
    changed: set[int] = set()
    for line in diff_text.splitlines():
        match = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
        if not match:
            continue
        start = int(match.group(1))
        length = int(match.group(2) or "1")
        if length == 0:
            continue
        changed.update(range(start, start + length))
    return changed


def changed_line_numbers(rel_path: str, path: Path) -> set[int]:
    if rel_path in git_lines(["ls-files", "--others", "--exclude-standard"]):
        line_count = len(path.read_text(encoding="utf-8", errors="ignore").splitlines())
        return set(range(1, line_count + 1))
    changed = parse_changed_lines(git_text(["diff", "--unified=0", "--", rel_path]))
    changed.update(parse_changed_lines(git_text(["diff", "--cached", "--unified=0", "--", rel_path])))
    return changed


def line_is_changed(changed_lines: set[int] | None, line_number: int) -> bool:
    return changed_lines is None or line_number in changed_lines


def lines_overlap_changed(changed_lines: set[int] | None, start_line: int, end_line: int) -> bool:
    if changed_lines is None:
        return True
    return any(line_number in changed_lines for line_number in range(start_line, end_line + 1))


def is_ignored_changed_path(path: str) -> bool:
    parts = Path(path).parts
    return (
        Path(path).name in IGNORED_CHANGED_NAMES
        or any(part in IGNORED_CHANGED_PARTS for part in parts)
        or path.endswith(".pyc")
    )


def is_production_java(path: Path) -> bool:
    rel = path.relative_to(PROJECT_ROOT)
    parts = rel.parts
    return (
        path.suffix == ".java"
        and all(part in parts for part in PRODUCTION_SOURCE_PARTS)
    )


def is_data_model(rel_path: str) -> bool:
    parts = Path(rel_path).parts
    return "domain" in parts or rel_path.endswith(MODEL_SUFFIXES)


def is_core_code(rel_path: str) -> bool:
    if is_data_model(rel_path):
        return False
    parts = set(Path(rel_path).parts)
    if parts.intersection(CORE_PATH_PARTS):
        return True
    return rel_path.endswith(CORE_SUFFIXES)


def strip_java_comments(text: str) -> str:
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    return "\n".join(line for line in text.splitlines() if not line.strip().startswith("//"))


def has_meaningful_text(text: str) -> bool:
    cleaned = re.sub(r"[/@*{}();,._=\-:`'\"\s]+", "", text)
    cjk_chars = re.findall(r"[一-鿿]", cleaned)
    return len(cjk_chars) >= MIN_CJK_CHARS or len(cleaned) >= MIN_MEANINGFUL_CHARS


def has_explanation_annotation(lines: list[str]) -> bool:
    for line in lines:
        stripped = line.strip()
        if not stripped.startswith(EXPLANATION_ANNOTATIONS):
            continue
        if any(key in stripped for key in ("description", "name", "value", "title")):
            return True
    return False


def has_comment_explanation(lines: list[str]) -> bool:
    block = "\n".join(lines)
    javadoc_blocks = re.findall(r"/\*\*(.*?)\*/", block, flags=re.DOTALL)
    if any(has_meaningful_text(comment) for comment in javadoc_blocks):
        return True

    line_comments = [
        line.strip()[2:].strip()
        for line in lines
        if line.strip().startswith("//")
    ]
    return any(has_meaningful_text(comment) for comment in line_comments)


def preceding_documentation_lines(lines: list[str], declaration_index: int) -> list[str]:
    collected: list[str] = []
    index = declaration_index - 1
    while index >= 0 and len(collected) < 40:
        stripped = lines[index].strip()
        if not stripped:
            index -= 1
            continue
        if stripped.startswith("/**"):
            collected.insert(0, lines[index])
            break
        if stripped.startswith("/*") and stripped.endswith("*/"):
            collected.insert(0, lines[index])
            break
        if stripped.startswith("@") or stripped.startswith("//") or stripped.startswith("*") or stripped.endswith("*/"):
            collected.insert(0, lines[index])
            index -= 1
            continue
        if "*/" in stripped:
            collected.insert(0, lines[index])
            index -= 1
            while index >= 0 and "/**" not in lines[index]:
                collected.insert(0, lines[index])
                index -= 1
            if index >= 0:
                collected.insert(0, lines[index])
            break
        break
    return collected


def check_class_comments(path: Path, changed_lines: set[int] | None = None) -> list[str]:
    rel_path = path.relative_to(PROJECT_ROOT).as_posix()
    lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    violations: list[str] = []
    for index, line in enumerate(lines):
        if not CLASS_DECLARATION_RE.search(line):
            continue
        if not line_is_changed(changed_lines, index + 1):
            continue
        if has_comment_explanation(preceding_documentation_lines(lines, index)):
            continue
        violations.append(f"{rel_path}:{index + 1} class is missing class comment")
    return violations


def is_field_line(line: str) -> bool:
    stripped = line.strip()
    if not stripped or stripped.startswith(("@", "//", "*")):
        return False
    if "(" in stripped or not stripped.endswith(";"):
        return False
    if re.search(r"\b(static\s+final|serialVersionUID|log|LOGGER)\b", stripped):
        return False
    return bool(re.match(r"(private|protected|public)\s+[\w<>\[\], ?]+\s+\w+(\s*=.*)?;", stripped))


def preceding_explanation_lines(lines: list[str], field_index: int) -> list[str]:
    collected: list[str] = []
    index = field_index - 1
    while index >= 0 and len(collected) < 12:
        stripped = lines[index].strip()
        if not stripped:
            index -= 1
            continue
        if is_field_line(stripped) or stripped == "}":
            break
        if stripped.startswith("/**"):
            collected.insert(0, lines[index])
            break
        if stripped.startswith("/*") and stripped.endswith("*/"):
            collected.insert(0, lines[index])
            break
        if stripped.startswith("@") or stripped.startswith("//") or stripped.startswith("*") or stripped.endswith("*/"):
            collected.insert(0, lines[index])
            index -= 1
            continue
        if "*/" in stripped:
            collected.insert(0, lines[index])
            index -= 1
            while index >= 0 and "/**" not in lines[index]:
                collected.insert(0, lines[index])
                index -= 1
            if index >= 0:
                collected.insert(0, lines[index])
            break
        break
    return collected


def check_data_model(path: Path, changed_lines: set[int] | None = None) -> list[str]:
    violations: list[str] = []
    rel_path = path.relative_to(PROJECT_ROOT).as_posix()
    lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()

    for index, line in enumerate(lines):
        if not is_field_line(line):
            continue
        if not line_is_changed(changed_lines, index + 1):
            continue
        context = preceding_explanation_lines(lines, index)
        if not (has_comment_explanation(context) or has_explanation_annotation(context)):
            violations.append(f"{rel_path}:{index + 1} field is missing explanation")
    return violations


def meaningful_comments_after_class(text: str) -> list[str]:
    comments: list[str] = []
    lines = text.splitlines()
    class_line = 0
    for index, line in enumerate(lines):
        if re.search(r"\b(class|interface|enum)\s+\w+", line):
            class_line = index
            break
    tail = "\n".join(lines[class_line + 1:])
    comments.extend(match.group(1) for match in re.finditer(r"/\*\*(.*?)\*/", tail, flags=re.DOTALL))
    comments.extend(match.group(1) for match in re.finditer(r"/\*(.*?)\*/", tail, flags=re.DOTALL))
    comments.extend(match.group(1) for match in re.finditer(r"//\s*(.*)", tail))
    return [comment for comment in comments if has_meaningful_text(comment)]


def has_executable_logic(text: str) -> bool:
    clean = strip_java_comments(text)
    return (
        len(re.findall(r"\b(if|for|while|switch|try|catch|return|throw|new)\b", clean)) >= 3
        or len(re.findall(r"\b(public|protected|private)\s+[\w<>\[\], ?]+\s+\w+\s*\(", clean)) >= 3
    )


def primary_class_name(text: str) -> str | None:
    match = CLASS_DECLARATION_RE.search(text)
    if not match:
        return None
    return match.group(2)


def find_method_body_end(lines: list[str], start_index: int) -> int:
    depth = 0
    started = False
    for index in range(start_index, len(lines)):
        clean_line = strip_java_comments(lines[index])
        for char in clean_line:
            if char == "{":
                depth += 1
                started = True
            elif char == "}":
                depth -= 1
                if started and depth <= 0:
                    return index
    return start_index


def discover_methods(lines: list[str]) -> list[MethodInfo]:
    methods: list[MethodInfo] = []
    index = 0
    while index < len(lines):
        stripped = lines[index].strip()
        if not stripped.startswith(ACCESS_MODIFIERS) or "(" not in stripped:
            index += 1
            continue

        declaration_lines = [lines[index]]
        cursor = index
        while "{" not in "\n".join(declaration_lines) and ";" not in "\n".join(declaration_lines):
            cursor += 1
            if cursor >= len(lines) or cursor - index > 8:
                break
            declaration_lines.append(lines[cursor])

        declaration_text = " ".join(line.strip() for line in declaration_lines)
        if ";" in declaration_text or "{" not in declaration_text:
            index += 1
            continue
        if (
            " class " in declaration_text
            or " interface " in declaration_text
            or " enum " in declaration_text
            or " record " in declaration_text
        ):
            index += 1
            continue

        match = METHOD_DECLARATION_RE.search(declaration_text)
        if not match:
            index += 1
            continue

        body_end = find_method_body_end(lines, cursor)
        methods.append(
            MethodInfo(
                name=match.group(2),
                access=match.group(1),
                declaration_index=index,
                body_start_index=cursor,
                body_end_index=body_end,
                declaration_lines=declaration_lines,
                body_lines=lines[cursor : body_end + 1],
            )
        )
        index = max(body_end + 1, index + 1)
    return methods


def has_override_annotation(context: list[str]) -> bool:
    return any(line.strip().startswith("@Override") for line in context)


def is_simple_accessor(method: MethodInfo) -> bool:
    if not method.name.startswith(("get", "set", "is")):
        return False
    clean = strip_java_comments("\n".join(method.body_lines))
    return len(re.findall(r";", clean)) <= 1 and not BRANCH_FLOW_RE.search(clean)


def is_trivial_delegation(method: MethodInfo) -> bool:
    clean = strip_java_comments("\n".join(method.body_lines))
    if BRANCH_FLOW_RE.search(clean) or STATUS_FLOW_RE.search(clean):
        return False
    statements = len(re.findall(r";", clean))
    return statements <= 1 and bool(re.search(r"\b(return\s+)?\w+\.\w+\s*\(", clean))


def has_method_logic(method: MethodInfo) -> bool:
    clean = strip_java_comments("\n".join(method.body_lines))
    body = re.sub(r"^[^{]*\{", "", clean, count=1, flags=re.DOTALL)
    body = body.rsplit("}", 1)[0] if "}" in body else body
    return bool(re.search(r"\b(if|for|while|switch|try|catch|return|throw|new)\b|[.;=]", body))


def is_comment_required_method(method: MethodInfo, class_name: str | None, context: list[str]) -> bool:
    if class_name and method.name == class_name:
        return False
    if has_override_annotation(context):
        return False
    if not has_method_logic(method):
        return False
    if is_simple_accessor(method) or is_trivial_delegation(method):
        return False
    return True


def requires_flow_comment(method: MethodInfo) -> bool:
    clean = strip_java_comments("\n".join(method.body_lines))
    branch_count = len(BRANCH_FLOW_RE.findall(clean))
    has_status_flow = bool(STATUS_FLOW_RE.search(clean)) and branch_count >= 1
    has_branch_flow = branch_count >= 4 or "switch" in clean
    return has_status_flow or has_branch_flow


def check_core_methods(path: Path, changed_lines: set[int] | None = None) -> list[str]:
    rel_path = path.relative_to(PROJECT_ROOT).as_posix()
    text = path.read_text(encoding="utf-8", errors="ignore")
    lines = text.splitlines()
    class_name = primary_class_name(text)
    violations: list[str] = []

    for method in discover_methods(lines):
        method_changed = line_is_changed(changed_lines, method.declaration_index + 1)
        body_changed = lines_overlap_changed(changed_lines, method.body_start_index + 1, method.body_end_index + 1)
        context = preceding_documentation_lines(lines, method.declaration_index)
        if method_changed and is_comment_required_method(method, class_name, context) and not has_comment_explanation(context):
            violations.append(f"{rel_path}:{method.declaration_index + 1} method is missing method comment")
        if body_changed and requires_flow_comment(method) and not (
            has_comment_explanation(context) or has_comment_explanation(method.body_lines[1:-1])
        ):
            violations.append(
                f"{rel_path}:{method.declaration_index + 1} status/branch flow is missing comment"
            )
    return violations


def check_core_code(path: Path, changed_lines: set[int] | None = None) -> list[str]:
    rel_path = path.relative_to(PROJECT_ROOT).as_posix()
    text = path.read_text(encoding="utf-8", errors="ignore")
    if not has_executable_logic(text) and not discover_methods(text.splitlines()):
        return []
    violations = check_core_methods(path, changed_lines)
    if has_executable_logic(text) and lines_overlap_changed(changed_lines, 1, len(text.splitlines())) and not meaningful_comments_after_class(text):
        violations.append(f"{rel_path}: core code is missing core comments")
    return violations


def check_java_file(path: Path, changed_lines: set[int] | None = None) -> list[str]:
    rel_path = path.relative_to(PROJECT_ROOT).as_posix()
    violations = check_class_comments(path, changed_lines)
    if is_data_model(rel_path):
        violations.extend(check_data_model(path, changed_lines))
    elif is_core_code(rel_path):
        violations.extend(check_core_code(path, changed_lines))
    return violations


def main() -> int:
    violations: list[str] = []
    for rel_path in sorted(changed_paths()):
        path = PROJECT_ROOT / rel_path
        if not path.is_file() or not is_production_java(path):
            continue
        violations.extend(check_java_file(path, changed_line_numbers(rel_path, path)))

    if violations:
        print("Java documentation contract violations:")
        for violation in violations[:100]:
            print(f"  {violation}")
        if len(violations) > 100:
            print(f"  ... {len(violations) - 100} more")
        return 1

    print("Java documentation contract ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
