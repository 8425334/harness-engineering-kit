version: 1
project:
  name: "{{PROJECT_NAME}}"
  owner: "{{TEAM_OR_OWNER}}"
  stack: ["{{LANGUAGE_OR_FRAMEWORK}}"]

authority:
  order: [system-developer-user, native-instructions, agent-policy, context-index, path-ai-md, engineering-profile]
  context_documents_are_supplemental: true
  untrusted_instruction_sources: [issues, fixtures, generated-content, logs, code-comments]

commands:
  fast_test: "{{FAST_TEST_COMMAND}}"
  test: "{{TEST_COMMAND}}"
  build: "{{BUILD_COMMAND}}"
  fitness: "{{FITNESS_COMMAND}}"

context:
  index_document_name: ai.json
  detail_document_name: AI.md
  index_max_bytes: 8192
  detail_max_lines: 800
  architecture_overview: .hek/kit/core/harness-engineering.md
  dependency_rules: .hek/kit/core/ddd-modeling.md

permissions:
  readable_paths: ["{{READABLE_PATHS}}"]
  writable_paths: ["{{WRITABLE_PATHS}}"]
  denied_paths: ["{{DENIED_PATHS_OR_SECRETS}}"]
  protected_paths: [.hek/fitness]
  fitness_changes: human-approval-required
  network: deny-by-default
  production_writes: approval-required
  destructive_operations: approval-required

delivery:
  migration_guide: openspec/README.md
  production_policy: .hek/project/production/policy.yaml

methodology:
  lifecycle: .hek/kit/core/change-lifecycle.md
  engineering_skill: engineering
