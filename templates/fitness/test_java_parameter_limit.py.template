    with tempfile.TemporaryDirectory(prefix="jpl-parse-") as td:
        root = Path(td)
        config = make_config(root, "mod")
        write_workspace(root, "mod", {
            "demo/Broken.java": "package demo; class Broken { void m( }",  # 语法错误
        })
        rc, _ = run_checker(root, config)
        check("parse_failure_fails_closed", rc != 0)


def test_fitness_runner_exitcode_pattern() -> None:
    """task 4.5：配置 pattern 的 metric 必须同时要求退出码为零（非零但含成功文本 → 失败）。"""
    fitness = Path(__file__).resolve().parent / "fitness.py"
    # 模拟：命令输出成功哨兵但退出非零 → runner 必须判失败
    probe_dir = Path(tempfile.mkdtemp(prefix="jpl-fit-"))
    probe_md = probe_dir / "probe.md"
    probe_md.write_text(
        "---\nmetrics:\n  - name: probe\n    command: echo 'Java parameter object gate ok'; exit 3\n"
        "    pattern: 'Java parameter object gate ok'\n    hard_gate: true\n    tier: fast\n---\n",
        encoding="utf-8")
    # 让 runner 扫描该规则文件：临时拷贝 FITNESS_DIR？runner 扫描固定目录，改为直接测逻辑。
    # 直接验证 fitness.py 的判定语义：非零退出 + pattern 命中 → FAIL。
    from fitness import run_metric
    metric = {"command": "echo 'Java parameter object gate ok'; exit 3", "pattern": "Java parameter object gate ok"}
    import fitness as fit
    # 用子进程验证（run_metric 直接调 subprocess）
    ok, out = run_metric(metric, "fast", dry_run=False, verbose=False)
    check("nonzero_exit_with_success_text_fails", not ok)
    # 正常命令零退出 + pattern → 通过
    metric_ok = {"command": "echo 'Java parameter object gate ok'", "pattern": "Java parameter object gate ok"}
    ok2, _ = run_metric(metric_ok, "fast", dry_run=False, verbose=False)
    check("zero_exit_with_success_text_passes", ok2)
    shutil.rmtree(probe_dir, ignore_errors=True)


def main() -> int:
    test_parameter_boundaries()
    test_record_and_complex_syntax()
    test_baseline_exact_and_stale()
    test_exception_validation()
    test_parse_failure_fails_closed()
    test_fitness_runner_exitcode_pattern()

    if FAILURES:
        for name in FAILURES:
            print(f"FAIL: {name}")
        print("NOT OK")
        return 1
    print("OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
